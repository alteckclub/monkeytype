{
  "name": "@monkeytype/contracts",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsup-node"
  },
  "dependencies": {
    "@monkeytype/schemas": "*"
  },
  "devDependencies": {
    "@monkeytype/tsup-config": "*",
    "@monkeytype/typescript-config": "*",
    "tsup": "8.4.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@ts-rest/core": "3.52.1",
    "zod": "3.23.8"
  }
}
